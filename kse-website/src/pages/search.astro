---
import Layout from '../layouts/Default.astro';
---
<Layout title="KeyStore Explorer - Search" editPath="src/pages/search.astro">

<div class="page-header">
    <h1>Search</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <div id="search"></div>
    </div>
</div>

</Layout>

<!--
  Pagefind's index and UI assets (/pagefind/pagefind-ui.js, pagefind-ui.css)
  are generated by `pagefind --site dist`, chained onto the `build` script
  after `astro build`, so they only exist in the built output — not during
  `astro dev`. Loaded as plain inline tags (not Astro-processed imports) so
  the dev server doesn't try to resolve them. Run `npm run build && npm run
  preview` to test search locally.
-->
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI === 'undefined') return;

    new PagefindUI({ element: '#search', showSubResults: true });

    // Pre-fill and trigger the search when arriving via the navbar dropdown's
    // "View all results" link (?q=...), so this page doesn't land empty.
    const q = new URLSearchParams(window.location.search).get('q');
    if (q) {
      const searchInput = document.querySelector('#search .pagefind-ui__search-input');
      if (searchInput) {
        searchInput.value = q;
        searchInput.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }
  });
</script>
