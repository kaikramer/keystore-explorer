---
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  version: '5.4' | '5.5' | '5.6';
  editPath: string;
}
const { title, version, editPath } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<Head title={title} />

<body role="document">
    <Nav version={version} active="doc" />
    <div class="container" role="main">
        <div class="row">
            <div class="col-sm-8">
                <slot />
            </div>
            <div class="col-sm-4 mt-5 pt-4">
                <nav id="toc" class="sticky-top"></nav>
            </div>
        </div>
        <hr />
        <Footer editPath={editPath} />
    </div>
</body>

</html>
